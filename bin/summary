#!/usr/bin/env ruby
# frozen_string_literal: true

# Builds the root RESULTS.md: the latest evidence per model, how each model's numbers progressed
# across runs, and links to every run's own (unchanged) tables. Data only; no verdicts.
require "json"
require "yaml"

ROOT = File.expand_path("..", __dir__)

# Runs in the order they happened. `kind` says how to read each one.
RUNS = [
  { id: "2026-10-19", label: "Run 1: screen", note: "2-min coding box, 1,024-token answers, 2-min agentic box" },
  { id: "2026-10-19-extended", label: "Run 2: extended", note: "all 161 problems, 4,096-token answers, 60-min cap, 10-min agentic box" },
  { id: "2026-10-20-8k", label: "Run 3: 8k re-run", note: "coding only, 8,192-token answers, no time cap; verbose models only" },
  { id: "2026-10-20-gemma32k", label: "Run 4: Gemma 32k", note: "coding only, 32,768-token answers; stopped at problem 30" },
  { id: "2026-10-20-ornith8-agentic", label: "Run 5: Ornith 8-bit agentic re-test", note: "agentic task only, Run 2 settings: 10-min box, 30 turns, 4,096 tokens per turn" },
  { id: "2026-10-20-agentic5", label: "Run 6: agentic ×5 for the builder candidates", note: "agentic task only, Run 2 settings; 5 attempts per candidate including earlier ones" }
].freeze

def load_run(id)
  Dir[File.join(ROOT, "results", id, "*.json")].to_h do |f|
    r = JSON.parse(File.read(f, encoding: "UTF-8"))
    [r["model"], r]
  end
end

data = RUNS.to_h { [_1[:id], load_run(_1[:id])] }
config = YAML.load_file(File.join(ROOT, "config/models.yml"))["models"].to_h { [_1["id"], _1] }

# Run 4 (Gemma 32k) ended before the harness wrote JSON; its figures come from its README.
GEMMA = "mlx-community--gemma-4-26b-a4b-it-4bit"
GEMMA_32K = { passed: 23, attempted: 30, note: "6 of 30 answers never finished" }.freeze

def coding(r) = r&.dig("screens", "coding")
def pct(c)
  return "—" unless c && c["attempted"].to_i.positive?

  rate = c["pass_rate"] ? c["pass_rate"].to_f * 100 : c["passed"] * 100.0 / c["attempted"]
  "#{rate.round}% (#{c['passed']}/#{c['attempted']})"
end
def agentic(r) = (a = r&.dig("screens", "agentic")) && !a.empty? ? (a["solved"] ? "solved" : "not solved") : nil

models = data["2026-10-19-extended"].keys.sort_by(&:downcase)
short = ->(m) { m.sub(/\Amlx-community--/, "").sub(/:qwen-3-8-27b-instruct\z/, "") }
deleted = ->(m) { config.dig(m, "parked").to_s =~ /deleted/i ? " <sup>(d)</sup>" : "" }

out = []
out << "# Results"
out << ""
out << "Every result table from every run, **in the order the runs happened**, followed by a summary across runs."
out << "Each run's own page is also kept unchanged in its folder. Built by `bin/summary`."
out << "Method, caveats and the time/cost view: [`README.md`](README.md). Why models were kept or cut: [`DECISIONS.md`](DECISIONS.md)."
out << ""
out << "<sup>(d)</sup> = since deleted from the test Mac (kept here as history)."
out << ""

# Full contents of every run, oldest first. Each run's own page is included as-is (headings pushed down two levels).
out << "## All results, in the order they were run"
out << ""
RUNS.each do |run|
  page = %w[RESULTS.md README.md].map { File.join(ROOT, "results", run[:id], _1) }.find { File.exist?(_1) }
  next unless page

  body = File.read(page, encoding: "UTF-8")
  body = body.gsub(/^(#+) /) { "###{$1} " }
  body = body.gsub("](../", "](results/").gsub(/\]\((?!https?:|#|results\/)([^)]+)\)/) { "](results/#{run[:id]}/#{$1})" }
  out << "---" << ""
  out << "### #{run[:label]} (#{run[:note]})"
  out << ""
  out << body.sub(/\A#+ [^\n]*\n/, "").strip
  out << ""
end
out << "---" << ""
out << "## Summary across runs"
out << ""

# 1. Weighted score v2 with the latest results: same table format as Run 2's v2 table.
# Coding comes from Run 3 where that model completed it (more room to finish), otherwise Run 2.
# Agentic comes from Run 2. Gemma-4-26B's Run 4 (32k) left no per-answer data, so its Run 2 figures stand.
W = { agentic: 0.4, accuracy: 0.3, throughput: 0.2, memory: 0.05, vision: 0.05 }.freeze
f = ->(v, d = 1) { v.nil? ? "—" : v.is_a?(Numeric) ? v.round(d).to_s : v.to_s }
rows = models.map do |m|
  r2 = data.dig("2026-10-19-extended", m)
  c3 = coding(data.dig("2026-10-20-8k", m))
  c = c3 && c3["stop"] == "completed" ? c3 : coding(r2)
  hours = c["problems"].sum { _1["seconds"].to_f } / 3600
  net = hours.positive? ? (c["passed"] - (c["attempted"] - c["passed"])) / hours : nil
  { model: m, src: c.equal?(c3) ? "Run 3" : "Run 2", c: c, net: net, size: r2["size_gb"].to_f,
    agentic: r2.dig("screens", "agentic", "solved") ? 1.0 : 0.0, vision: config.dig(m, "vision") ? 1.0 : 0.0 }
end
max_sph = rows.map { _1[:c]["solved_per_hour"].to_f }.max
max_gb = rows.map { _1[:size] }.max
rows.each do |r|
  r[:accuracy] = r[:c]["pass_rate"].to_f
  r[:throughput] = Math.log(1 + r[:c]["solved_per_hour"].to_f) / Math.log(1 + max_sph)
  r[:memory] = 1 - r[:size] / max_gb
  r[:score] = W.sum { |k, x| x * r[k] } * 100
end
out << "### Weights v2 (2026-10-20): adds vision, taken from memory, with the latest results"
out << ""
out << "Score = 100 × (#{W.map { |k, x| "#{x} × #{k}" }.join(' + ')}). A model that reads images avoids handing screenshots"
out << "to a second model, which costs time and memory."
out << ""
out << "Latest results: coding from Run 3 (8,192-token answers, no time cap) for the models it covered, otherwise Run 2;"
out << "agentic from Run 2. The Source column says which. Throughput and memory are scaled against the best in this table."
out << ""
out << "- **Solve rate (/hr)**: projected correct answers per hour of Mac time at the measured pace. A rate, not a count:"
out << "  there are only 161 problems (e.g. 136 right in 12 minutes ≈ 693 an hour)."
out << "- **Net solve rate (/hr)**: the same, minus the wrong answers in that hour; each wrong answer cancels a right one."
out << "  Negative means it produces more wrong code than right. Small samples exaggerate both (qwen3-coder-rails answered"
out << "  only 20 problems)."
out << ""
out << "| Model | Source | #{W.map { |k, x| "#{k.to_s.capitalize} (×#{x})" }.join(' | ')} | **Score** | Solve rate (/hr) | Net solve rate (/hr) |"
out << "|#{'---|' * (W.size + 5)}"
rows.sort_by { -_1[:score] }.each do |r|
  name = "#{r[:model]}#{deleted.(r[:model])}"
  out << "| #{name} | #{r[:src]} | #{W.keys.map { f.(r[_1], 2) }.join(' | ')} | **#{f.(r[:score])}** | " \
         "#{f.(r[:c]['solved_per_hour'])} | #{f.(r[:net], 0)} |"
end
out << ""

# 1b. The same views as Run 2's extended tables, with the latest results (same columns, plus Source).
FAMILY_ORDER = ["Qwen3.8", "Qwen3.6", "Qwen3.5", "Qwen3 ", "Gemma 4", "IQuest"].freeze
family = ->(r) { config.dig(r[:model], "family") || "Other" }
view_row = lambda do |r|
  c = r[:c]
  a = data.dig("2026-10-19-extended", r[:model], "screens", "agentic") || {}
  whole = c["problems"].reject { _1["hit_cap"] }
  clean = whole.empty? ? "—" : "#{(whole.count { _1['passed'] } * 100.0 / whole.size).round}% (#{whole.count { _1['passed'] }} of #{whole.size} finished)"
  "| #{r[:model]}#{deleted.(r[:model])} | #{r[:src]} | #{c['passed']}/#{c['attempted']} | #{(c['pass_rate'].to_f * 100).round}% | #{clean} | " \
    "#{f.(c['seconds_per_problem'])} | #{f.(c['solved_per_hour'])} | #{c['hit_cap']} | #{c['stop']} | " \
    "#{a.empty? ? '—' : (a['solved'] ? '**solved**' : 'not solved')} | #{a.empty? ? '—' : "#{a['turns']} / #{a['stop']} / #{f.(a['seconds'])}"} |"
end
view_head = ["| Model | Source | Pass / attempted | Pass rate | Pass rate excl. cut-off | s / problem | Solve rate (/hr) | Hit token cap | Stop | Agentic | Agentic turns / stop / s |",
             "|---|---|---|---|---|---|---|---|---|---|---|"]
rate = ->(r) { r[:c]["pass_rate"].to_f }
per_hour = ->(r) { r[:c]["solved_per_hour"].to_f }
views = [
  ["By model name", rows.sort_by { _1[:model].downcase }],
  ["By pass rate (most accurate first)", rows.sort_by { [-rate.(_1), -per_hour.(_1)] }],
  ["By solve rate (speed × accuracy)", rows.sort_by { [-per_hour.(_1), -rate.(_1)] }],
  ["Grouped by agentic result, then solve rate", rows.sort_by { [-_1[:agentic], -per_hour.(_1)] }],
  [:family, rows]
]
views.each do |title, list|
  if title == :family
    out << "### Grouped by family (Qwen newest first, then Gemma), then solve rate, with the latest results" << ""
    out.concat(view_head)
    list.group_by { family.(_1) }.sort_by { |fam, _| [FAMILY_ORDER.index { fam.start_with?(_1) } || FAMILY_ORDER.size, fam] }.each do |fam, ms|
      out << "| **#{fam}** | | | | | | | | | | |"
      ms.sort_by { -per_hour.(_1) }.each { out << view_row.(_1) }
    end
  else
    out << "### #{title}, with the latest results" << ""
    out.concat(view_head)
    list.each { out << view_row.(_1) }
  end
  out << ""
end

# 2. Progression
out << "### Progression: Ruby pass rate run by run"
out << ""
out << "The same model across runs. The rules changed between runs, so a jump usually means the model was given more"
out << "room, not that it got better: Run 1 stopped after 2 minutes, Run 2 cut answers at 4,096 tokens, Run 3 at 8,192."
out << ""
out << "**Latest** is each model's most recent result (the run is named in the cell). Rows are sorted by it, highest first."
out << ""
out << "| Model | Run 1: screen | Run 2: extended | Run 3: 8k | Run 4: 32k | **Latest** |"
out << "|---|---|---|---|---|---|"
prog = models.map do |m|
  r1 = coding(data.dig("2026-10-19", m))
  r2 = coding(data.dig("2026-10-19-extended", m))
  r3 = coding(data.dig("2026-10-20-8k", m))
  r3 = nil unless r3 && r3["attempted"].to_i.positive?
  r4 = m == GEMMA ? { "passed" => GEMMA_32K[:passed], "attempted" => GEMMA_32K[:attempted] } : nil
  latest, run = [[r4, "Run 4"], [r3, "Run 3"], [r2, "Run 2"], [r1, "Run 1"]].find { |c, _| c }
  rate = latest["pass_rate"] ? latest["pass_rate"].to_f : latest["passed"].to_f / latest["attempted"]
  { m: m, cells: [r1, r2, r3, r4].map { _1 ? pct(_1) : "—" }, latest: "**#{pct(latest)}** · #{run}", rate: rate }
end
prog.sort_by { [-_1[:rate], _1[:m].downcase] }.each do |p|
  out << "| #{short.(p[:m])}#{deleted.(p[:m])} | #{p[:cells].join(' | ')} | #{p[:latest]} |"
end
out << ""

# 3. Runs
out << "### Where each run's page lives"
out << ""
RUNS.each do |run|
  page = File.exist?(File.join(ROOT, "results", run[:id], "RESULTS.md")) ? "RESULTS.md" : "README.md"
  page = nil unless File.exist?(File.join(ROOT, "results", run[:id], page))
  link = page ? "[`results/#{run[:id]}/#{page}`](results/#{run[:id]}/#{page})" : "[`results/#{run[:id]}/`](results/#{run[:id]}/)"
  out << "- **#{run[:label]}** (#{run[:note]}): #{link}"
end
out << "- **Run logs** for all of them (host addresses redacted): [`results/logs/`](results/logs/)"
out << ""
out << "Run 2's page also has the weighted scores (v1 and v2), the family grouping and the sorted views."
out << "Run 3 was stopped during its last model (Gemma-4-26B, rerun as Run 4), so that model has no Run 3 row."

File.write(File.join(ROOT, "RESULTS.md"), out.join("\n") + "\n")
puts out
